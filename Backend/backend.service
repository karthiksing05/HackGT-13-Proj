[Unit]
Description=SideQuestz API
After=network.target mongod.service ml.service
Wants=ml.service

[Service]
Type=simple
User=sidequestz
Group=sidequestz
WorkingDirectory=/opt/backend
EnvironmentFile=/opt/backend/.env
ExecStart=/opt/backend/sidequestz-server
Restart=always
RestartSec=3
LimitNOFILE=65536

# Hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
