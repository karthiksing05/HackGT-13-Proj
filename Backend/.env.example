# SideQuestz backend environment (docs/design/backend-contract.md §8).
# Copy to /opt/backend/.env on the server (chmod 600) or export locally.
APP_ENV=prod                      # dev relaxes the JWT/FB checks and defaults PUBLIC_BASE_URL
HTTP_ADDR=127.0.0.1:8080          # PORT is accepted as a fallback
PUBLIC_BASE_URL=https://api.sidequestz.tech
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=freetime
JWT_SECRET=replace-with-openssl-rand-base64-48-output
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=720h
ML_SERVICE_URL=http://127.0.0.1:8000
ML_RERANK=true
ML_RERANK_TOP_K=12
ML_RANK_TIMEOUT_MS=2000
ML_RANK_RERANK_TIMEOUT_MS=20000
ML_EMBED_TIMEOUT_MS=15000
ML_SEARCH_TIMEOUT_MS=5000
PLANNER=dag                       # auto | dag | legacy (pkg/planner reads PLANNER_* knobs)
FB_APP_ID=
FB_APP_SECRET=
FB_GRAPH_VERSION=v26.0
FB_TOKEN_KEY=                     # 32-byte hex; empty = derived from JWT_SECRET
DEMO_PASSWORD=                    # seed-demo only
DEMO_TZ=America/New_York
# DEMO_DATE=YYYY-MM-DD: demo accounts (catalog demo_activities) live on that date in DEMO_TZ,
# at the real time of day; leave it empty for real time.
DEMO_DATE=
DEV_RESET_CODES=0                 # 1 returns the reset code from /auth/password/forgot
CHECKOUT_STEP_DELAY=1500ms
TRUST_PROXY=1                     # behind nginx
MAX_PHOTO_BYTES=2097152
MAX_JSON_BYTES=1048576

# Agentic checkout (Muse buys a plan's tickets on the Events merchant; Stripe TEST mode only).
# Off (the endpoints answer 503) until STRIPE_SECRET_KEY, STRIPE_SELLER_PROFILE and a signing key are set.
PAYMENTS_MODE=sandbox             # required whenever STRIPE_SECRET_KEY is set
STRIPE_SECRET_KEY=                # sk_test_… / rk_test_… (live keys are refused): issues Shared Payment Tokens
STRIPE_SELLER_PROFILE=            # the merchant's Stripe profile (profile_…) the tokens are scoped to
MERCHANT_HOST=events.sidequestz.tech            # the host the TAP signature covers; must match Events' MERCHANT_HOST
MERCHANT_BASE_URL=https://events.sidequestz.tech # where requests go (http://localhost:8085 for a local Events)
TAP_AGENT_KEY=                    # base64 Ed25519 seed from `sidequestz-admin tap-keygen`; empty = the repo demo key, dev only
MUSE_API_KEY=                     # Meta Model API; without it the code fallback buys the tickets
MUSE_MODEL=muse-spark-1.3
MUSE_BASE_URL=https://api.meta.ai/v1
AGENT_MAX_TURNS=24
CHECKOUT_RUN_TIMEOUT=3m
