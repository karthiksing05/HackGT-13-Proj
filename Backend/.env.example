# SideQuestz backend environment (docs/design/backend-contract.md §8).
# Copy to /opt/backend/.env on the server (chmod 600) or export locally.
APP_ENV=prod                      # dev relaxes the JWT/FB checks and defaults PUBLIC_BASE_URL
HTTP_ADDR=127.0.0.1:8080          # PORT is accepted as a fallback
PUBLIC_BASE_URL=https://api.sidequestz.tech
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=freetime
JWT_SECRET=replace-with-openssl-rand-base64-48-output
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=720h
ML_SERVICE_URL=http://127.0.0.1:8000
ML_RERANK=true
ML_RERANK_TOP_K=12
ML_RANK_TIMEOUT_MS=2000
ML_RANK_RERANK_TIMEOUT_MS=20000
ML_EMBED_TIMEOUT_MS=15000
ML_SEARCH_TIMEOUT_MS=5000
PLANNER=dag                       # auto | dag | legacy (pkg/planner reads PLANNER_* knobs)
FB_APP_ID=
FB_APP_SECRET=
FB_GRAPH_VERSION=v26.0
FB_TOKEN_KEY=                     # 32-byte hex; empty = derived from JWT_SECRET
DEMO_PASSWORD=                    # seed-demo only
DEMO_TZ=America/New_York
DEV_RESET_CODES=0                 # 1 returns the reset code from /auth/password/forgot
CHECKOUT_STEP_DELAY=1500ms
TRUST_PROXY=1                     # behind nginx
MAX_PHOTO_BYTES=2097152
MAX_JSON_BYTES=1048576
