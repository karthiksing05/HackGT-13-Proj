[Unit]
Description=SideQuestz Backend Service
After=network.target mongod.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/sidequestz
ExecStart=/opt/sidequestz/sidequestz-server
Restart=always
RestartSec=5s

# Environment configuration
Environment=PORT=8080
Environment=MONGO_URI=mongodb://127.0.0.1:27017
Environment=MONGO_DB=hackgt
Environment=JWT_SECRET=replace_with_your_secure_random_production_secret
Environment=COOKIE_SECURE=true

# Security Hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
