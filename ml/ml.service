[Unit]
Description=SideQuestz ML FastAPI Inference Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ml
ExecStart=/opt/ml/.venv/bin/uvicorn api.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5s

# Python and Ranking Model Configuration
Environment=PYTHONPATH=/opt/ml
Environment=RANKING_MODEL=classifier
Environment=RANKING_DEVICE=cpu
Environment=USER_EMBEDDING_ALPHA=0.8
Environment=SEARCH_WEIGHT=0.6
Environment=RERANK_TOP_K=20

# Optional: Load extra secrets / config (e.g. TYPESAFE_API_KEY, HF_TOKEN) from .env if present
EnvironmentFile=-/opt/ml/.env

# Security Hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
