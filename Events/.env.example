# SideQuestz Events merchant (sandbox)
APP_ENV=dev
HTTP_ADDR=:8085
MERCHANT_HOST=events.sidequestz.tech
MERCHANT_BASE_URL=http://localhost:8085

# Sandbox only: the server refuses to start with any other value.
PAYMENTS_MODE=sandbox

# Demo key for POST /_demo/scenario (X-Demo-Key). Must be changed outside dev.
DEMO_KEY=sqz-booth-demo

# The SideQuestz agent's Ed25519 public key (base64), from
# `sidequestz-admin tap-keygen` in Backend/. Empty is allowed only in dev,
# where the demo key from the repo is trusted.
TAP_AGENT_PUBLIC_KEY=

# The merchant's Stripe TEST secret key (sk_test_… or rk_test_…): a DIFFERENT
# Stripe account (or sandbox) from the Backend's, since Stripe won't let an
# account issue a payment token to itself. STRIPE_MERCHANT_SECRET_KEY wins when
# both are set (one shared .env for local runs). Live keys are refused. Empty:
# orders answer 503.
STRIPE_MERCHANT_SECRET_KEY=

# MongoDB (if not running, automatically falls back to in-memory store)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=sidequestz_events

# The SideQuestz catalog whose paid items (ticketUrl on this host) are listed
# here, read from the same MongoDB at startup.
CATALOG_DB=freetime
CATALOG_COLLECTION=pitch_activities
