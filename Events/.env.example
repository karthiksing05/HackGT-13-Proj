# SideQuestz Events Server (Ticketmaster Demo & Merchant)
APP_ENV=dev
PORT=8081
HTTP_ADDR=:8081
MERCHANT_HOST=events.sidequestz.tech
MERCHANT_BASE_URL=http://localhost:8081

# Guaranteed sandbox mode
PAYMENTS_MODE=sandbox

# Keys
DEMO_KEY=sqz-booth-demo
SANDBOX_NETWORK_KEY=sqz-sbx-network-key-hackgt

# Optional external Visa sim URL (if empty, uses built-in simulated Visa network)
VISA_AUTHORIZE_URL=

# MongoDB (if not running, automatically falls back to in-memory store)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=sidequestz_events

# Optional Ed25519 private key seed (base64) for custom TAP key
TAP_AGENT_KEY=
