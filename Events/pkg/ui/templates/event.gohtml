{{template "head" .Meta}}
.crumbs { padding-block: 18px 0; font-size: 14px; color: var(--ink-3); }
.crumbs a { text-decoration: none; color: var(--ink-2); font-weight: 600; }
.crumbs a:hover { text-decoration: underline; }
.hero-img { position: relative; margin-top: 14px; border-radius: 20px; overflow: hidden; aspect-ratio: 21 / 9; background: var(--sea-tint); }
.hero-img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.layout { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 40px; margin-top: 28px; align-items: start; }
.kicker { font-size: 13px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--sea); }
h1 { font-size: clamp(32px, 5vw, 48px); margin-top: 8px; }
.facts { display: grid; gap: 14px; margin: 24px 0 0; padding: 0; list-style: none; }
.facts li { display: grid; grid-template-columns: 40px 1fr; gap: 12px; align-items: center; }
.facts .ico { width: 40px; height: 40px; border-radius: 12px; background: var(--sea-tint); color: var(--sea); display: grid; place-items: center; }
.facts b { display: block; font-weight: 700; }
.facts span { color: var(--ink-3); font-size: 15px; }
.about { margin-top: 32px; }
.about h2 { font-size: 22px; }
.about p { font-size: 17px; color: var(--ink-2); max-width: 64ch; margin: 10px 0 0; }
.buy { position: sticky; top: 20px; padding: 22px; }
.buy .from { color: var(--ink-3); font-size: 14px; font-weight: 600; }
.buy .amount { font-family: var(--display); font-size: 40px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.1; }
.buy .amount span { font: 500 16px var(--body); color: var(--ink-3); letter-spacing: 0; }
.buy .when { margin: 14px 0 18px; padding-top: 14px; border-top: 1px solid var(--line); font-size: 15px; color: var(--ink-2); }
.buy .note { margin: 12px 0 0; font-size: 13px; color: var(--ink-3); text-align: center; }
.buy .left { color: var(--buoy-deep); font-weight: 700; }
.mbar { display: none; }
@media (max-width: 860px) {
  .layout { grid-template-columns: 1fr; gap: 28px; }
  .buy { position: static; }
  .hero-img { aspect-ratio: 16 / 10; }
  body { padding-bottom: calc(84px + env(safe-area-inset-bottom, 0px)); }
  .mbar {
    display: flex; align-items: center; justify-content: space-between; gap: 14px;
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; background: var(--card); border-top: 1px solid var(--line);
    padding: 12px 20px calc(12px + env(safe-area-inset-bottom, 0px));
  }
  .mbar b { font-family: var(--display); font-size: 22px; }
  .mbar span { display: block; font-size: 13px; color: var(--ink-3); }
  .mbar .btn { height: 48px; flex: none; }
}
{{template "top" ""}}
{{with .Event}}
<div class="wrap">
  <nav class="crumbs" aria-label="Breadcrumb"><a href="/">All events</a> · <a href="/?category={{.Category}}">{{category .Category}}</a></nav>
  {{if .ImageURL}}<div class="hero-img"><img src="{{.ImageURL}}" alt=""></div>{{end}}

  <div class="layout">
    <article>
      <span class="kicker">{{category .Category}}</span>
      <h1>{{.Title}}</h1>
      <ul class="facts">
        <li>
          <span class="ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M3 10h18M8 3v4M16 3v4" stroke-linecap="round"/></svg></span>
          <div><b>{{longDate .Start}}</b><span>{{clock .Start}} – {{clock .End}}</span></div>
        </li>
        <li>
          <span class="ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span>
          <div><b>{{.Venue}}</b><span>{{.Address}}</span></div>
        </li>
      </ul>
      <section class="about">
        <h2>About this event</h2>
        <p>{{.Description}}</p>
      </section>
    </article>

    <aside class="buy panel" aria-label="Tickets">
      <div class="from">Tickets</div>
      <div class="amount num">{{money .UnitCents}} <span>each</span></div>
      <div class="when">{{date .Start}} · {{clock .Start}}<br>{{.Venue}}</div>
      {{if $.SoldOut}}
        <span class="btn block off" aria-disabled="true">Sold out</span>
      {{else}}
        <a class="btn block" href="/{{.Slug}}/tickets">Get tickets</a>
        <p class="note">{{if $.FewLeft}}<span class="left num">Only {{.Remaining}} left</span> · {{end}}Fees shown before you pay</p>
      {{end}}
    </aside>
  </div>
</div>
<div class="mbar">
  <div><b class="num">{{money .UnitCents}}</b><span>{{date .Start}} · {{clock .Start}}</span></div>
  {{if $.SoldOut}}<span class="btn off" aria-disabled="true">Sold out</span>{{else}}<a class="btn" href="/{{.Slug}}/tickets">Get tickets</a>{{end}}
</div>
{{end}}
{{template "bottom"}}
