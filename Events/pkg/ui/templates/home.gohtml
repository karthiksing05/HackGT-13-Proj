{{template "head" .Meta}}
.hero { background: var(--ink); color: #fff; padding-block: 36px 44px; }
.hero h1 { font-size: clamp(34px, 6vw, 60px); max-width: 16ch; }
.hero h1 em { font-style: normal; color: var(--buoy); }
.hero p { color: rgba(255,255,255,0.72); margin: 14px 0 0; font-size: 18px; max-width: 52ch; }
.filters { position: sticky; top: 0; z-index: 5; background: var(--paper); border-bottom: 1px solid var(--line); }
.filters .wrap { padding-block: 14px; }
.results { color: var(--ink-3); font-size: 14px; margin: 26px 0 0; }
.results a { margin-left: 6px; }
.day { margin-top: 34px; }
.day h2 { font-size: 22px; display: flex; align-items: baseline; gap: 10px; }
.day h2 span { font: 600 14px var(--body); color: var(--ink-3); letter-spacing: 0; }
.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px; margin-top: 16px; }
.card { display: flex; flex-direction: column; text-decoration: none; overflow: hidden; transition: transform .18s ease, box-shadow .18s ease; }
.card:hover { transform: translateY(-3px); box-shadow: 0 14px 30px -18px rgba(15,34,48,0.45); }
.card:focus-visible { outline: 3px solid var(--buoy); outline-offset: 2px; }
.thumb { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: var(--sea-tint); flex: none; }
.thumb img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.date-tag {
  position: absolute; left: 12px; top: 12px; background: #fff; border-radius: 10px; padding: 6px 9px 5px;
  text-align: center; font-weight: 700; line-height: 1.05; box-shadow: 0 4px 14px -6px rgba(0,0,0,0.35);
}
.date-tag small { display: block; font-size: 10px; letter-spacing: 0.08em; color: var(--buoy-deep); }
.date-tag b { font-family: var(--display); font-size: 15px; font-weight: 800; letter-spacing: -0.01em; }
.sold { position: absolute; right: 12px; top: 12px; background: var(--ink); color: #fff; font-size: 12px; font-weight: 700; padding: 5px 10px; border-radius: 999px; }
.card-body { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 4px; flex: 1; }
.kicker { font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--sea); }
.card h3 { font-size: 19px; line-height: 1.18; }
.where { color: var(--ink-3); font-size: 14px; }
.price { margin-top: auto; padding-top: 10px; font-weight: 700; }
.price span { color: var(--ink-3); font-weight: 500; }
.empty { margin-top: 48px; padding: 40px 24px; text-align: center; }
.empty h2 { font-size: 24px; }
.empty p { color: var(--ink-3); margin: 8px 0 18px; }
{{template "top" .Search}}
<section class="hero">
  <div class="wrap">
    <h1>Live music, late nights and <em>harbor days</em>.</h1>
    <p>Tickets for the best things to do in Saltlight Harbor this weekend.</p>
  </div>
</section>

<nav class="filters" aria-label="Categories">
  <div class="wrap chips">
    <a class="chip{{if not .Category}} on{{end}}" href="/{{with .Search}}?q={{.}}{{end}}">All events</a>
    {{range .Categories}}<a class="chip{{if .Active}} on{{end}}" href="/?category={{.Key}}{{with $.Search}}&q={{.}}{{end}}">{{.Label}}</a>{{end}}
  </div>
</nav>

<div class="wrap">
  {{if or .Search .Category}}
  <p class="results num">{{.Count}} {{if eq .Count 1}}event{{else}}events{{end}}{{with .Search}} matching “{{.}}”{{end}}{{if .Category}} in {{category .Category}}{{end}}<a class="link" href="/">Clear</a></p>
  {{end}}

  {{range .Days}}
  <section class="day">
    <h2>{{.Label}} <span class="num">{{len .Events}} {{if eq (len .Events) 1}}event{{else}}events{{end}}</span></h2>
    <div class="grid">
      {{range .Events}}
      <a class="card panel" href="/{{.Slug}}">
        <div class="thumb">
          {{if .ImageURL}}<img src="{{.ImageURL}}" alt="" loading="lazy">{{end}}
          <div class="date-tag"><small>{{weekday .Start}}</small><b>{{monthDay .Start}}</b></div>
          {{if le .Remaining 0}}<span class="sold">Sold out</span>{{end}}
        </div>
        <div class="card-body">
          <span class="kicker">{{category .Category}}</span>
          <h3>{{.Title}}</h3>
          <span class="where">{{.Venue}} · {{clock .Start}}</span>
          <span class="price num">{{money .UnitCents}} <span>per ticket</span></span>
        </div>
      </a>
      {{end}}
    </div>
  </section>
  {{else}}
  <div class="empty panel">
    <h2>No events found</h2>
    <p>Try another search or category.</p>
    <a class="btn" href="/">See all events</a>
  </div>
  {{end}}
</div>
{{template "bottom"}}
