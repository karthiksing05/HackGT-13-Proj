{{define "head"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
{{with .Description}}<meta name="description" content="{{.}}">{{end}}
<meta name="theme-color" content="#0f2230">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%230f2230'/%3E%3Cpath d='M9 20c2.5 2 4.5 2 7 0s4.5-2 7 0' stroke='%23ff6a3d' stroke-width='2.6' fill='none' stroke-linecap='round'/%3E%3Ccircle cx='16' cy='11' r='3.2' fill='%23ff6a3d'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=Figtree:wght@400;500;600;700&display=swap">
{{with .JSONLD}}<script type="application/ld+json">
{{.}}
</script>{{end}}
<style>
:root {
  --ink: #0f2230;
  --ink-2: #3d5260;
  --ink-3: #6c7e88;
  --paper: #f4f6f5;
  --card: #ffffff;
  --line: #dde4e3;
  --line-2: #c9d3d2;
  --buoy: #ff6a3d;
  --buoy-deep: #e24e22;
  --sea: #1d5566;
  --sea-tint: #e3eef0;
  --ok: #1f7a55;
  --danger: #c0392b;
  --radius: 16px;
  --display: "Bricolage Grotesque", "Avenir Next", "Segoe UI", system-ui, sans-serif;
  --body: "Figtree", -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
}
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body {
  margin: 0;
  background: var(--paper);
  color: var(--ink);
  font: 16px/1.5 var(--body);
  -webkit-font-smoothing: antialiased;
}
a { color: inherit; }
img { max-width: 100%; display: block; }
h1, h2, h3 { font-family: var(--display); font-weight: 800; letter-spacing: -0.02em; line-height: 1.08; text-wrap: balance; margin: 0; }
.wrap { max-width: 1120px; margin: 0 auto; padding-inline: 20px; }
.num { font-variant-numeric: tabular-nums; }

/* Header */
.site-header { background: var(--ink); color: #fff; }
.site-header .wrap { display: flex; align-items: center; gap: 20px; min-height: 64px; flex-wrap: wrap; padding-block: 10px; }
.logo { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font-family: var(--display); font-weight: 800; font-size: 20px; letter-spacing: -0.02em; }
.logo svg { flex: none; }
.search { margin-left: auto; flex: 1 1 260px; max-width: 380px; position: relative; }
.search input {
  width: 100%; height: 42px; border-radius: 999px; border: 1px solid rgba(255,255,255,0.18);
  background: rgba(255,255,255,0.08); color: #fff; padding: 0 16px 0 40px; font: 15px var(--body);
}
.search input::placeholder { color: rgba(255,255,255,0.6); }
.search input:focus { outline: 2px solid var(--buoy); outline-offset: 1px; background: rgba(255,255,255,0.12); }
.search svg { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); opacity: 0.7; }

/* Buttons */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  height: 52px; padding: 0 26px; border-radius: 999px; border: 0; cursor: pointer;
  background: var(--buoy); color: #fff; font: 700 16px var(--body); text-decoration: none;
  transition: background .15s ease, transform .15s ease;
}
.btn:hover { background: var(--buoy-deep); }
.btn:active { transform: translateY(1px); }
.btn:focus-visible { outline: 3px solid var(--ink); outline-offset: 2px; }
.btn.block { width: 100%; }
.btn[disabled], .btn.off { background: var(--line-2); color: var(--ink-3); cursor: not-allowed; }
.link { color: var(--sea); font-weight: 600; text-decoration: none; }
.link:hover { text-decoration: underline; }

/* Chips */
.chips { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 4px; scrollbar-width: none; }
.chips::-webkit-scrollbar { display: none; }
.chip {
  flex: none; height: 36px; padding: 0 15px; border-radius: 999px; border: 1px solid var(--line-2);
  display: inline-flex; align-items: center; font-weight: 600; font-size: 14px; text-decoration: none; color: var(--ink-2); background: var(--card);
}
.chip:hover { border-color: var(--ink); color: var(--ink); }
.chip.on { background: var(--ink); border-color: var(--ink); color: #fff; }

/* Card surface */
.panel { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); }

/* Footer */
.site-footer { margin-top: 72px; border-top: 1px solid var(--line); color: var(--ink-3); font-size: 14px; }
.site-footer .wrap { display: flex; flex-wrap: wrap; gap: 8px 24px; justify-content: space-between; padding-block: 28px; }

@media (max-width: 560px) {
  .search { max-width: none; order: 3; flex-basis: 100%; }
  .btn { height: 50px; }
}
{{end}}

{{define "top"}}
</style>
</head>
<body>
<header class="site-header">
  <div class="wrap">
    <a class="logo" href="/">
      <svg width="30" height="30" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="#ff6a3d"/><path d="M9 20c2.5 2 4.5 2 7 0s4.5-2 7 0" stroke="#0f2230" stroke-width="2.6" fill="none" stroke-linecap="round"/><circle cx="16" cy="11" r="3.2" fill="#0f2230"/></svg>
      {{site}}
    </a>
    <form class="search" action="/" method="get" role="search">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5" stroke-linecap="round"/></svg>
      <input type="search" name="q" value="{{.}}" placeholder="Search events, venues" aria-label="Search events">
    </form>
  </div>
</header>
<main>
{{end}}

{{define "bottom"}}
</main>
<footer class="site-footer">
  <div class="wrap">
    <span>{{site}} · Things to do in Saltlight Harbor, GA</span>
    <span>Secure payments by Stripe</span>
  </div>
</footer>
</body>
</html>
{{end}}
